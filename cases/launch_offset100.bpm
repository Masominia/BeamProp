# A lateral offset costs the squared overlap of the displaced mode with the guide mode.
# Reference: the overlap integral of the analytic modes on a fine grid.
title Mode launched 100 nm off the axis of its guide
window width=24 length=200
guide straight x=0 width=0.5 from=0 to=200
launch mode x=0.1 width=0.5
monitor out z=200 x=0 width=0.5
plane end z=200
expect power out 0.873824234 2e-7
expect total end 0.989104493 2e-7
expect centroid end -0.0335733 2e-6
expect radius end 0.6758767 2e-6
expect neff 2.629142305 2e-8
expect power out 0.87391 2e-3
