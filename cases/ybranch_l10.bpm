# A taper to double width followed by two diverging arms. Symmetry splits the power equally; the opening angle sets the loss.
# Reference: equal arms by symmetry; values from the independent propagation.
title Y-branch opening to 3 um over 10 um
window width=24 length=40
guide straight x=0 width=0.5 from=0 to=10
guide taper x=0 w0=0.5 w1=1.0 from=10 to=20
guide sbend x0=0.25 x1=1.5 width=0.5 from=20 to=30
guide sbend x0=-0.25 x1=-1.5 width=0.5 from=20 to=30
guide straight x=1.5 width=0.5 from=30 to=40
guide straight x=-1.5 width=0.5 from=30 to=40
launch mode x=0 width=0.5
monitor upper z=40 x=1.5 width=0.5
monitor lower z=40 x=-1.5 width=0.5
plane end z=40
expect power upper 0.495261588 2e-7
expect power lower 0.495261588 2e-7
expect total end 0.999990561 2e-7
expect centroid end -0.0000000 2e-6
expect radius end 2.9677403 2e-6
expect neff 2.339423758 2e-8
expect ratio upper lower 1.0 1e-6
