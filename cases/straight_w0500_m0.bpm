# A mode launched into its own guide keeps its shape and only gathers phase.
# Reference: the index of the mode of the transverse grid, from a dense eigen-solve.
title Straight guide 0.5 um wide, mode 0
window width=12 length=100
guide straight x=0 width=0.5 from=0 to=100
launch mode x=0 width=0.5 order=0
monitor out z=100 x=0 width=0.5 order=0
plane end z=100
expect power out 0.999998856 2e-7
expect total end 0.999999514 2e-7
expect centroid end -0.0000000 2e-6
expect radius end 0.2753074 2e-6
expect neff 2.628986590 2e-8
expect neff 2.62898659 2e-6
expect power_above out 0.9995
