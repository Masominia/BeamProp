# The power that stays guided is the squared overlap of the two mode profiles; the rest radiates into the absorbers.
# Reference: the overlap integral of the analytic modes on a fine grid.
title Mode of a 0.5 um guide launched into a 1.2 um guide
window width=24 length=200
guide straight x=0 width=1.2 from=0 to=200
launch mode x=0 width=0.5
monitor out z=200 x=0 width=1.2
plane end z=200
expect power out 0.810773831 2e-7
expect total end 0.986458319 2e-7
expect centroid end -0.0000000 2e-6
expect radius end 0.5765433 2e-6
expect neff 2.798893919 2e-8
expect power out 0.81087 2e-3
