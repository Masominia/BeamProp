# A lateral offset costs the squared overlap of the displaced mode with the guide mode.
# Reference: the overlap integral of the analytic modes on a fine grid.
title Mode launched 300 nm off the axis of its guide
window width=24 length=200
guide straight x=0 width=0.5 from=0 to=200
launch mode x=0.3 width=0.5
monitor out z=200 x=0 width=0.5
plane end z=200
expect power out 0.303768860 2e-7
expect total end 0.683233365 2e-7
expect centroid end -0.0847219 2e-6
expect radius end 2.1289405 2e-6
expect neff 2.041353351 2e-8
expect power out 0.30399 2e-3
